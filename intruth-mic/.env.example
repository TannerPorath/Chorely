# Copy to .env and fill in. All three can also be set from the in-app Settings panel.

# Required — real-time speech-to-text + speaker diarization (https://deepgram.com)
DEEPGRAM_API_KEY=

# Required — claim extraction + verdicts (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Optional — web search to ground verdicts with sources (https://serper.dev)
SERPER_API_KEY=

# Optional — override the Claude model used for fact-checking
# FACTCHECK_MODEL=claude-haiku-4-5-20251001

# Optional — port the server listens on inside the container
# PORT=3000
